    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\nconst status = String(body.status ?? '').trim();\nconst phone = String(body.client_phone ?? '').replace(/\\D/g, '');\nconst instance = String(body.instance_name ?? '').trim();\n\nlet message = '';\nif (status === 'Em preparo') {\n  message = '👨‍🍳 Seu pedido já está em preparo!';\n} else if (status === 'Pronto') {\n  message = '✅ Seu pedido está pronto!';\n} else if (status === 'Saiu para entrega') {\n  message = '🛵 Seu pedido saiu para entrega! Já já chega por aí.';\n} else if (status === 'Finalizados') {\n  message = '✅ Pedido entregue! 😊 De 1 a 5, que nota você dá para seu pedido?';\n} else if (status === 'Cancelados') {\n  message = 'Seu pedido foi cancelado. Se precisar de ajuda, fala com a gente por aqui.';\n}\n\nreturn [{\n  json: {\n    event: String(body.event ?? ''),\n    company_id: String(body.company_id ?? ''),\n    company_name: String(body.company_name ?? ''),\n    company_instagram: String(body.company_instagram ?? ''),\n    instance_name: instance,\n    order_id: String(body.order_id ?? ''),\n    customer_id: String(body.customer_id ?? ''),\n    client_name: String(body.client_name ?? ''),\n    client_phone: phone,\n    reply_jid: phone ? `${phone}@s.whatsapp.net` : '',\n    status,\n    previous_status: String(body.previous_status ?? ''),\n    message,\n    notify: Boolean(\n      body.event === 'ORDER_STATUS_CHANGED' &&\n      body.company_id &&\n      body.order_id &&\n      instance &&\n      phone &&\n      message\n    ),\n    is_finalized: status === 'Finalizados'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -650,
        300
      ],
